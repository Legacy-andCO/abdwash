APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/abdwash
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Backend-only fallback for legacy HS256 projects; prefer asymmetric JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Required only when running the demo staff seeder. Never expose this to clients.
DEMO_STAFF_PASSWORD=
CORS_ORIGINS=["http://localhost:3000"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
# Set true only for transaction-mode poolers such as Supavisor on port 6543.
DB_DISABLE_PREPARED_STATEMENTS=false
LOG_LEVEL=INFO
# Backend-only HMAC key; keep stable so customer management links remain valid.
BOOKING_MANAGEMENT_SIGNING_KEY=replace-with-at-least-32-random-characters
# Backend-only transactional email configuration. Never expose these as NEXT_PUBLIC values.
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_WEB_URL=http://localhost:3000
# Strong random secret accepted only by the bounded internal dispatch endpoint.
OUTBOX_DISPATCH_SECRET=
# Backend-only Google Routes API credential. Restrict it to Routes API and the API deployment.
GOOGLE_ROUTES_API_KEY=
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=20
