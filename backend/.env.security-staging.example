# Copy to an ignored .env.security-staging ONLY after creating the separate project.
# Never load backend/.env or copy production credentials into this environment.
APP_ENV=staging
DATABASE_URL=postgresql+asyncpg://trifecta_staging_api:REPLACE@STAGING_DATABASE_HOST:5432/postgres
DB_REQUIRE_TLS=true
SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=STAGING_ONLY_SECRET_FROM_SECRET_MANAGER
BOOKING_MANAGEMENT_SIGNING_KEY=
CORS_ORIGINS=["https://staging-web.example.com"]
PUBLIC_WEB_URL=https://staging-web.example.com
JOB_PHOTO_BUCKET=job-quality-photos
EXPENSE_EVIDENCE_BUCKET=expense-evidence
# Intentionally empty; staging factory also unconditionally uses log-only delivery.
RESEND_API_KEY=
# EMAIL_FROM must remain unset while mail is suppressed.
OUTBOX_DISPATCH_SECRET=
