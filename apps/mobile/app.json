{
  "expo": {
    "name": "Trifecta Staff",
    "slug": "abdwash-staff",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Trifecta uses your location once when starting a trip to calculate the customer's arrival estimate."
      }
    },
    "android": {
      "package": "com.abdwash.staff",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trifecta lets staff select vehicle evidence photos for an authorized job.",
          "cameraPermission": "Trifecta uses the camera only when staff capture vehicle evidence for an authorized job.",
          "microphonePermission": false
        }
      ],
      "./plugins/withAndroidImeInsets",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "8ace044f-315e-40dc-955b-4bedcc350687"
      }
    },
    "owner": "bboost"
  }
}
