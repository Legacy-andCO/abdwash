{
  "framework": null,
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm ci --prefix ../..",
  "rewrites": [{ "source": "/:path*", "destination": "/index.html" }],
  "headers": [{ "source": "/:path*", "headers": [
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" },
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
  ] }]
}
