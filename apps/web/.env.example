NEXT_PUBLIC_API_URL=http://localhost:8000
# Public browser key. Restrict it by HTTPS referrer and API in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional locally; use a production Google Cloud map ID for the live site.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Public Supabase project settings used by the browser Auth client. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
